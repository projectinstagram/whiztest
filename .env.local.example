# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local

# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram human-handoff — bot token from @BotFather, group ID of your support supergroup
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_GROUP_ID=-1001234567890
